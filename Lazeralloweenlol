or input.UserInputType == Enum.UserInputType.Touch then

	dragging = true 	dragStart = input.Position 	startPosition = window.Position 	input.Changed:Connect(function() 		if input.UserInputState == Enum.UserInputState.End then 			dragging = false 		end 	end) end 

end)

UserInputService.InputChanged:Connect(function(input)
if not dragging then
return
end

if input.UserInputType == Enum.UserInputType.MouseMovement 	or input.UserInputType == Enum.UserInputType.Touch then 	local delta = input.Position - dragStart 	window.Position = UDim2.new( 		startPosition.X.Scale, 		startPosition.X.Offset + delta.X, 		startPosition.Y.Scale, 		startPosition.Y.Offset + delta.Y 	) end 

end)

