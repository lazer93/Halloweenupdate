	highlight.OutlineColor =
		Color3.fromRGB(
			255,
			255,
			0
		)

	highlight.DepthMode =
		Enum.HighlightDepthMode.AlwaysOnTop

	highlight.Parent =
		target
end

--======================================================
-- FIND NEAREST TARGET
--======================================================

local function findNearestTarget()

	local character =
		player.Character

	if not character then
		return nil, nil
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return nil, nil
	end

	local nearestPrompt =
		nil

	local nearestTarget =
		nil

	local nearestDistance =
		math.huge

	for _, object in ipairs(
		Workspace:GetDescendants()
	) do

		if not autoScanEnabled then
			return nil, nil
		end

		if object:IsA(
			"ProximityPrompt"
		)
		and object.Enabled then

			local isMatch =
				matches(
					object.Name
				)
				or
				matches(
					object.ActionText
				)
				or
				matches(
					object.ObjectText
				)
				or
				(
					object.Parent
					and
					matches(
						object.Parent.Name
					)
				)

			if isMatch then

				local target =
					findTarget(object)

				if target then

					local position =
						getPosition(target)

					if position then

						local distance =
							(
								root.Position
								- position
							).Magnitude

						if distance <
							nearestDistance then

							nearestDistance =
								distance

							nearestPrompt =
								object

							nearestTarget =
								target
						end
					end
				end
			end
		end
	end

	return nearestPrompt,
		nearestTarget
end

--======================================================
-- INTERACT
--======================================================

local function interactWithPrompt(prompt)

	if not autoScanEnabled then
		return
	end

	if not prompt then
		return
	end

	if not prompt.Parent then
		return
	end

	if not prompt.Enabled then
		return
	end

	if instantInteractEnabled then

		if originalHoldDurations[prompt] ==
			nil then

			originalHoldDurations[prompt] =
				prompt.HoldDuration
		end

		prompt.HoldDuration =
			0
	end

	prompt:InputHoldBegin()

	local holdTime =
		prompt.HoldDuration

	if holdTime > 0 then
		task.wait(holdTime)
	end

	if prompt.Parent then
		prompt:InputHoldEnd()
	end
end

--======================================================
-- SCAN / TELEPORT / PICKUP
--======================================================

local function scanAndCollect()

	if not autoScanEnabled then
		return
	end

	local character =
		player.Character

	if not character then

		status.Text =
			"Character not ready."

		return
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then

		status.Text =
			"Character not ready."

		return
	end

	local prompt, target =
		findNearestTarget()

	if not autoScanEnabled then
		return
	end

	if not prompt
		or not target then

		status.Text =
			"❌ No Pumpkin/Pick found."

		return
	end

	local position =
		getPosition(target)

	if not position then
		return
	end

	addHighlight(target)

	if not autoScanEnabled then
		return
	end

	root.CFrame =
		CFrame.new(
			position +
				TELEPORT_OFFSET
		)

	status.Text =
		"🎃 Teleported to target."

	task.wait(0.05)

	if not autoScanEnabled then
		return
	end

	if prompt.Parent
		and prompt.Enabled then

		status.Text =
			"⚡ Picking up target..."

		interactWithPrompt(
			prompt
		)

	else

		status.Text =
			"Target prompt disappeared."
	end
end

--======================================================
-- AUTO SCAN LOOP
--======================================================

local function startAutoScan()

	if autoScanRunning then
		return
	end

	autoScanRunning =
		true

	task.spawn(function()

		while autoScanEnabled do

			scanAndCollect()

			if autoScanEnabled then

				task.wait(
					SCAN_DELAY
				)
			end
		end

		autoScanRunning =
			false

		status.Text =
			"⏹️ Auto scan stopped."
	end)
end

--======================================================
-- INSTANT INTERACT
--======================================================

local function setInstantInteract(enabled)

	instantInteractEnabled =
		enabled

	for _, object in ipairs(
		Workspace:GetDescendants()
	) do

		if object:IsA(
			"ProximityPrompt"
		) then

			if enabled then

				if originalHoldDurations[object] ==
					nil then

					originalHoldDurations[object] =
						object.HoldDuration
				end

				object.HoldDuration =
					0

			else

				if originalHoldDurations[object] ~=
					nil then

					object.HoldDuration =
						originalHoldDurations[object]
				end
			end
		end
	end

	if enabled then

		instantInteract.Text =
			"INSTANT INTERACT: ON"

		instantInteract.BackgroundColor3 =
			Color3.fromRGB(
				25,
				170,
				80
			)

	else

		instantInteract.Text =
			"INSTANT INTERACT: OFF"

		instantInteract.BackgroundColor3 =
			Color3.fromRGB(
				35,
				110,
				220
			)
	end
end

