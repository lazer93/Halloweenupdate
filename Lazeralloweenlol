local function getRank(targetPlayer)

	if not targetPlayer then
		return nil
	end

	local username =
		string.lower(targetPlayer.Name)

	if username ==
		string.lower(OWNER_USERNAME) then

		return "🏆 Owner"

	elseif username ==
		string.lower(COOWNER_USERNAME) then

		return "🏆 Co Owner"
	end

	return nil
end

