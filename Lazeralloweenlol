toggle.MouseButton1Click:Connect(
	function()

		window.Visible =
			not window.Visible

		if window.Visible then

			toggle.Text =
				"CLOSE SCANNER"

		else

			toggle.Text =
				"OPEN SCANNER"
		end
	end
)

--======================================================
-- AUTO SCAN TOGGLE
--======================================================

scan.MouseButton1Click:Connect(
	function()

		autoScanEnabled =
			not autoScanEnabled

		if autoScanEnabled then

			scan.Text =
				"🎃 AUTO SCAN: ON"

			scan.BackgroundColor3 =
				Color3.fromRGB(
					25,
					170,
					80
				)

			status.Text =
				"⚡ Scanning..."

			startAutoScan()

		else

			scan.Text =
				"🎃 AUTO SCAN: OFF"

			scan.BackgroundColor3 =
				Color3.fromRGB(
					45,
					145,
					70
				)

			status.Text =
				"⏹️ Auto scan stopped."
		end
	end
)

--======================================================
-- INSTANT INTERACT TOGGLE
--======================================================

instantInteract.MouseButton1Click:Connect(
	function()

		setInstantInteract(
			not instantInteractEnabled
		)

		if instantInteractEnabled then

			status.Text =
				"⚡ Instant interact enabled."

		else

			status.Text =
				"Instant interact disabled."
		end
	end
)

