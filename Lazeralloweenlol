--======================================================
-- HELPERS
--======================================================

local function matches(text)
if not text then
return false
end

text = string.lower(tostring(text)) return string.find(text, "pumpkin", 1, true) 	or string.find(text, "pick", 1, true) 

end

local function getPosition(object)
if object:IsA("BasePart") then
return object.Position

elseif object:IsA("Attachment") then 	return object.WorldPosition elseif object:IsA("Model") then 	return object:GetPivot().Position end return nil 

end

local function findTarget(prompt)
local current = prompt

while current and current ~= Workspace do 	if current:IsA("Model") and matches(current.Name) then 		return current 	end 	if current:IsA("BasePart") then 		return current 	end 	current = current.Parent end return nil 

end

local function addHighlight(target)
local old = target:FindFirstChild(HIGHLIGHT_NAME)

if old then 	old:Destroy() end local highlight = Instance.new("Highlight") highlight.Name = HIGHLIGHT_NAME highlight.Adornee = target highlight.FillColor = Color3.fromRGB(255, 140, 0) highlight.FillTransparency = 0.25 highlight.OutlineColor = Color3.fromRGB(255, 255, 0) highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop highlight.Parent = target 

end

--======================================================
-- FAST SCAN
--======================================================

local function scanAndCollect()

scan.Active = false scan.Text = "⚡ SCANNING..." status.Text = "Scanning..." local character = player.Character if not character then 	status.Text = "Character not ready." 	scan.Active = true 	scan.Text = "🎃 SCAN + PICKUP" 	return end local root = character:FindFirstChild("HumanoidRootPart") if not root then 	status.Text = "Character not ready." 	scan.Active = true 	scan.Text = "🎃 SCAN + PICKUP" 	return end local nearestPrompt local nearestTarget local nearestDistance = math.huge for _, object in ipairs(Workspace:GetDescendants()) do 	if object:IsA("ProximityPrompt") and object.Enabled then 		if matches(object.Name) 			or matches(object.ActionText) 			or matches(object.ObjectText) 			or (object.Parent and matches(object.Parent.Name)) then 			local target = findTarget(object) 			if target then 				local position = getPosition(target) 				if position then 					local distance = 						(root.Position - position).Magnitude 					if distance < nearestDistance then 						nearestDistance = distance 						nearestPrompt = object 						nearestTarget = target 					end 				end 			end 		end 	end end if not nearestPrompt or not nearestTarget then 	status.Text = "❌ No Pumpkin/Pick found." 	scan.Active = true 	scan.Text = "🎃 SCAN + PICKUP" 	return end local position = getPosition(nearestTarget) if not position then 	scan.Active = true 	scan.Text = "🎃 SCAN + PICKUP" 	return end addHighlight(nearestTarget) root.CFrame = 	CFrame.new(position + Vector3.new(0, 3, 0)) status.Text = "🎃 PICKING UP..." task.wait(0.05) status.Text = "✅ PICKUP COMPLETE" scan.Active = true scan.Text = "🎃 SCAN + PICKUP" 

end

