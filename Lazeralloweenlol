--======================================================
-- MATCHING
--======================================================

local function matches(text)

	if not text then
		return false
	end

	text = string.lower(tostring(text))

	return string.find(text, "pumpkin", 1, true)
		or string.find(text, "pick", 1, true)
end

--======================================================
-- GET POSITION
--======================================================

local function getPosition(object)

	if not object then
		return nil
	end

	if object:IsA("BasePart") then
		return object.Position

	elseif object:IsA("Attachment") then
		return object.WorldPosition

	elseif object:IsA("Model") then
		return object:GetPivot().Position
	end

	return nil
end

--======================================================
-- FIND TARGET BELONGING TO PROMPT
--======================================================

local function findTarget(prompt)

	local current = prompt

	while current and current ~= Workspace do

		if current:IsA("Model") and matches(current.Name) then
			return current
		end

		if current:IsA("BasePart") then
			return current
		end

		current = current.Parent
	end

	return nil
end

--======================================================
-- HIGHLIGHT
--======================================================

local function addHighlight(target)

	if not target then
		return
	end

	local old = target:FindFirstChild(HIGHLIGHT_NAME)

	if old then
		old:Destroy()
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = HIGHLIGHT_NAME
	highlight.Adornee = target
	highlight.FillColor = Color3.fromRGB(255, 140, 0)
	highlight.FillTransparency = 0.25
	highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = target
end

--======================================================
-- FIND NEAREST MATCHING TARGET
--======================================================

local function findNearestTarget()

	local character = player.Character

	if not character then
		return nil, nil
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	if not root then
		return nil, nil
	end

	local nearestPrompt = nil
	local nearestTarget = nil
	local nearestDistance = math.huge

	for _, object in ipairs(Workspace:GetDescendants()) do

		if not autoScanEnabled then
			return nil, nil
		end

		if object:IsA("ProximityPrompt")
			and object.Enabled then

			local isMatch =
				matches(object.Name)
				or matches(object.ActionText)
				or matches(object.ObjectText)
				or (
					object.Parent
					and matches(object.Parent.Name)
				)

			if isMatch then

				local target = findTarget(object)

				if target then

					local position = getPosition(target)

					if position then

						local distance =
							(root.Position - position).Magnitude

						if distance < nearestDistance then

							nearestDistance = distance
							nearestPrompt = object
							nearestTarget = target

						end
					end
				end
			end
		end
	end

	return nearestPrompt, nearestTarget
end

--======================================================
-- INTERACT WITH THE EXACT PROMPT FOUND
--======================================================

local function interactWithPrompt(prompt)

	if not autoScanEnabled then
		return
	end

	if not prompt then
		return
	end

	if not prompt.Parent then
		return
	end

	if not prompt.Enabled then
		return
	end

	-- Instant mode only changes the prompt that was found.
	if instantInteractEnabled then

		if originalHoldDurations[prompt] == nil then
			originalHoldDurations[prompt] =
				prompt.HoldDuration
		end

		prompt.HoldDuration = 0
	end

	-- Interact with THIS target's prompt.
	prompt:InputHoldBegin()

	local holdTime = prompt.HoldDuration

	if holdTime > 0 then
		task.wait(holdTime)
	end

	if prompt.Parent then
		prompt:InputHoldEnd()
	end
end

--======================================================
-- SCAN -> TELEPORT -> SAME TARGET INTERACT
--======================================================

local function scanAndCollect()

	if not autoScanEnabled then
		return
	end

	local character = player.Character

	if not character then
		status.Text = "Character not ready."
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	if not root then
		status.Text = "Character not ready."
		return
	end

	-- Find the target and its OWN prompt.
	local prompt, target = findNearestTarget()

	if not autoScanEnabled then
		return
	end

	if not prompt or not target then
		status.Text = "❌ No Pumpkin/Pick found."
		return
	end

	local position = getPosition(target)

	if not position then
		return
	end

	addHighlight(target)

	--==================================================
	-- TELEPORT TO THE TARGET
	--==================================================

	if not autoScanEnabled then
		return
	end

	root.CFrame =
		CFrame.new(position + TELEPORT_OFFSET)

	status.Text = "🎃 Teleported to target."

	-- Give the teleport a tiny moment to register.
	task.wait(0.05)

	if not autoScanEnabled then
		return
	end

	--==================================================
	-- ONLY INTERACT WITH THE PROMPT WE JUST FOUND
	--==================================================

	if prompt.Parent and prompt.Enabled then

		status.Text = "⚡ Picking up target..."

		interactWithPrompt(prompt)

	else

		status.Text = "Target prompt disappeared."
	end
end

--======================================================
-- AUTO SCAN LOOP
--======================================================

local function startAutoScan()

	if autoScanRunning then
		return
	end

	autoScanRunning = true

	task.spawn(function()

		while autoScanEnabled do

			scanAndCollect()

			if autoScanEnabled then
				task.wait(SCAN_DELAY)
			end
		end

		autoScanRunning = false

		status.Text = "⏹️ Auto scan stopped."
	end)
end

--======================================================
-- INSTANT INTERACT
--======================================================

local function setInstantInteract(enabled)

	instantInteractEnabled = enabled

	for _, object in ipairs(Workspace:GetDescendants()) do

		if object:IsA("ProximityPrompt") then

			if enabled then

				if originalHoldDurations[object] == nil then
					originalHoldDurations[object] =
						object.HoldDuration
				end

				object.HoldDuration = 0

			else

				if originalHoldDurations[object] ~= nil then
					object.HoldDuration =
						originalHoldDurations[object]
				end
			end
		end
	end

	if enabled then

		instantInteract.Text =
			"INSTANT INTERACT: ON"

		instantInteract.BackgroundColor3 =
			Color3.fromRGB(25, 170, 80)

	else

		instantInteract.Text =
			"INSTANT INTERACT: OFF"

		instantInteract.BackgroundColor3 =
			Color3.fromRGB(35, 110, 220)
	end
end

