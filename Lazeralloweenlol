local function getRank(targetPlayer)

	if not targetPlayer then
		return nil
	end

	local username = string.lower(targetPlayer.Name)

	if username == string.lower(OWNER_USERNAME) then
		return "OWNER"
	end

	if username == string.lower(COOWNER_USERNAME) then
		return "COOWNER"
	end

	return nil
end

