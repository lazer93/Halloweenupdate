--======================================================
-- MATCH TEXT
--======================================================

local function matches(text)

	if not text then
		return false
	end

	text =
		string.lower(
			tostring(text)
		)

	return
		string.find(
			text,
			"pumpkin",
			1,
			true
		)
		or
		string.find(
			text,
			"pick",
			1,
			true
		)
end

--======================================================
-- GET POSITION
--======================================================

local function getPosition(object)

	if not object then
		return nil
	end

	if object:IsA("BasePart") then

		return object.Position

	elseif object:IsA("Attachment") then

		return object.WorldPosition

	elseif object:IsA("Model") then

		return object:GetPivot().Position
	end

	return nil
end

--======================================================
-- FIND TARGET
--======================================================

local function findTarget(prompt)

	local current =
		prompt

	while current
		and current ~= Workspace do

		if current:IsA("Model")
			and matches(current.Name) then

			return current
		end

		if current:IsA("BasePart") then
			return current
		end

		current =
			current.Parent
	end

	return nil
end

